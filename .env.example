# AutoGuard AI Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# AI Provider Selection: 'ollama' (Local AI) or 'gemini' (Cloud AI)
VITE_AI_PROVIDER=ollama

# Local AI (Ollama) Settings
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2:3b
VITE_OLLAMA_VISION_MODEL=moondream

# Cloud AI (Gemini) Settings (Optional if using Local AI)
GEMINI_API_KEY=your_gemini_api_key_from_aistudio
VITE_GEMINI_API_KEY=your_gemini_api_key_from_aistudio

# Firebase Settings (Optional)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

